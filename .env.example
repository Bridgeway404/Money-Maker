# Copy to .env.local and fill in. All variables are server-side unless
# prefixed NEXT_PUBLIC_. Never commit real values.

# Supabase project (auth + database). The anon key is safe to expose to the
# browser; row-level security enforces per-user access.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic API key — used ONLY by server-side API routes. Never exposed to
# the browser.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: override the Claude model used by the API routes.
# Defaults to claude-sonnet-4-6 (see src/lib/ai/client.ts).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Neon (database tooling only — the app runtime still uses Supabase until the
# post-Phase-1.5 cutover; see docs/neon-migration/). Provided in Vercel by the
# Neon integration. NEVER commit, print, or log the real values, and never
# reference either variable from browser code.
# DATABASE_URL=            # pooled — future server runtime only
# DATABASE_URL_UNPOOLED=   # direct — migrations/seeds (npm run db:migrate / db:seed)

# Required by db:migrate / db:seed alongside DATABASE_URL_UNPOOLED: name the
# Neon branch the connection string points at. Branches named
# main/master/production/prod are refused without the explicit
# ALLOW_PRODUCTION_MIGRATION override (reserved for the approved cutover).
# NEON_TARGET_BRANCH=development
# NEON_TARGET_IS_PRODUCTION=false

# Database-backed RLS tests (drizzle/__tests__/rls.db.test.ts) run only when
# this is set. Point it at a DISPOSABLE Neon development branch.
# NEON_TEST_DATABASE_URL=

# Future Neon Auth / Data API cutover (blocked on Next >= 16 — Phase 1.5;
# see docs/neon-migration/02-research-and-compatibility.md):
# NEON_AUTH_BASE_URL=              # server; from Neon console -> Auth
# NEON_AUTH_COOKIE_SECRET=         # server-only; >= 32 chars (openssl rand -base64 48)
# NEXT_PUBLIC_NEON_AUTH_URL=       # browser auth client
# NEXT_PUBLIC_NEON_DATA_API_URL=   # browser Data API client
